# Copy to .env and fill in. NEVER commit .env (PRD §15.2). Every value below is fake.

# --- Runtime -----------------------------------------------------------------------------
APP_ENV=development                     # development | test | production

# --- Database (docker compose `db`, or Tiger Cloud in production) ------------------------
POSTGRES_USER=aegis
POSTGRES_DB=aegis
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://aegis:change-me-local-only@127.0.0.1:55432/aegis

# --- Next.js -> FastAPI trust boundary (PRD §8.5). 32+ random chars, same value both sides
AEGIS_PROXY_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32
AEGIS_API_URL=http://127.0.0.1:8000

# --- Auth (PRD §3.2, §4.3) ---------------------------------------------------------------
AEGIS_AUTH_MODE=auth0                   # auth0 | dev (dev is refused when APP_ENV=production)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.aegis.example
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=replace-with-32-byte-hex-session-secret
APP_BASE_URL=http://localhost:3000
# Dev mode only: keys generated by scripts/dev_keys.py into .env (never committed)
AEGIS_DEV_JWT_PUBLIC_KEY=
AEGIS_DEV_JWT_PRIVATE_KEY=

# --- Seams (M1 §0.3). Comma list of seams to fake on this branch -------------------------
# Day one every machine fakes all six. Remove a seam once its real code is on your branch:
#   M1 removes `arena` (app/arena/service.py)      M2 removes `firewall`, `read`, `admin`
#   M3 removes `risky`, `judge`                    At integration the list is empty.
AEGIS_USE_FAKES=firewall,read,admin,risky,judge,arena
AEGIS_FAKE_SCRIPT=dev                   # dev = keyword-driven fake firewall for the UI

# --- Arena limits (PRD §6.1, §15.1) -------------------------------------------------------
AEGIS_HOURLY_MESSAGE_CAP=30
AEGIS_DAILY_LLM_BUDGET=3000
AEGIS_AFF_TIMEOUT_S=30

# --- Models (pin exact IDs at G0, PRD §18.2) ----------------------------------------------
XAI_API_KEY=your-xai-api-key
GEMINI_API_KEY=your-gemini-api-key
AEGIS_GROK_MODEL_ID=grok-model-id-pinned-at-g0
AEGIS_GEMINI_FLASH_MODEL_ID=gemini-flash-model-id-pinned-at-g0
AEGIS_GEMINI_PRO_MODEL_ID=gemini-pro-model-id-pinned-at-g0
AEGIS_GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-model-id-pinned-at-g0
